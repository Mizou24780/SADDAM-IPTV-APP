<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0b18"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- App Title / Logo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SADDAM LIVE TV"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#8b5cf6"
        android:layout_marginBottom="40dp" />

    <!-- Host Input -->
    <EditText
        android:id="@+id/etHost"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#161226"
        android:hint="رابط السيرفر (http://example.com:8080)"
        android:textColor="#ffffff"
        android:textColorHint="#9ca3af"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:focusable="true" />

    <!-- Username Input -->
    <EditText
        android:id="@+id/etUser"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#161226"
        android:hint="اسم المستخدم (Username)"
        android:textColor="#ffffff"
        android:textColorHint="#9ca3af"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:focusable="true" />

    <!-- Password Input -->
    <EditText
        android:id="@+id/etPass"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#161226"
        android:hint="كلمة المرور (Password)"
        android:inputType="textPassword"
        android:textColor="#ffffff"
        android:textColorHint="#9ca3af"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:focusable="true" />

    <!-- Login Button -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#8b5cf6"
        android:text="تسجيل الدخول"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold"
        android:focusable="true" />

</LinearLayout>
